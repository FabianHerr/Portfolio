# Contact form (components/ContactForm.tsx) — Web3Forms access key.
# Get one free at https://web3forms.com (enter fabianherrerap73@gmail.com, check the email).
# Safe to expose: it only routes submissions to that verified inbox.
# Copy this file to .env.local and fill it in; also add it in the Vercel project's
# Environment Variables so the deployed form works. Without it, the form shows a
# "email me directly" fallback instead of sending.
NEXT_PUBLIC_WEB3FORMS_KEY=
